---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  video?: { webm: string; mp4: string };
}

const { src, alt, video } = Astro.props;

const className =
  "outline -outline-offset-1 outline-[oklch(0_0_0/0.1)] select-none pointer-events-none inline-block sm:hidden lg:inline-block sm:max-w-95 w-full self-start order-1 sm:order-2";

// `src` doubles as the poster frame when a video is given
const poster = video && (await getImage({ src, format: "webp" }));
---

{video && poster ? (
    <video
      data-preview-video
      poster={poster.src}
      width={src.width}
      height={src.height}
      aria-label={alt}
      muted
      loop
      playsinline
      preload="metadata"
      class={className}
    >
      <source src={video.webm} type="video/webm" />
      <source src={video.mp4} type="video/mp4" />
    </video>
  ) : (
    <Image src={src} alt={alt} class={className} />
  )}

<script>
// Autoplay only when motion is allowed; reduced motion keeps the poster frame.
if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
  for (const v of document.querySelectorAll<HTMLVideoElement>(
    "[data-preview-video]",
  )) {
    v.play().catch(() => {});
  }
}
</script>
