---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  video?: { webm: string; mp4: string };
}

const { src, alt, video } = Astro.props;
---

<div
  data-preview
  class="relative outline -outline-offset-1 outline-[oklch(0_0_0/0.1)] select-none pointer-events-none inline-block sm:hidden lg:inline-block sm:max-w-95 w-full self-start order-1 sm:order-2"
>
  {video && (
      <video
        width={src.width}
        height={src.height}
        muted
        loop
        playsinline
        preload="metadata"
        class="absolute inset-0 size-full"
      >
        <source src={video.webm} type="video/webm" />
        <source src={video.mp4} type="video/mp4" />
      </video>
    )}
  <Image
    src={src}
    alt={alt}
    class="relative w-full transition-opacity duration-150 ease-out"
  />
</div>

<script>
if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
  const canHover = matchMedia("(hover: hover)").matches;

  for (const wrapper of document.querySelectorAll<HTMLElement>(
    "[data-preview]",
  )) {
    const video = wrapper.querySelector("video");
    const poster = wrapper.querySelector("img");
    if (!video || !poster) continue;

    let active = false;

    const reset = () => {
      if (active) return;
      video.pause();
      video.currentTime = 0;
    };

    const start = () => {
      active = true;
      if (video.paused) video.play().catch(() => {});
      else poster.classList.add("opacity-0");
    };

    const stop = () => {
      active = false;
      if (poster.classList.contains("opacity-0")) {
        poster.classList.remove("opacity-0");
      } else {
        reset();
      }
    };

    video.addEventListener("playing", () => {
      if (active) poster.classList.add("opacity-0");
      else reset();
    });
    poster.addEventListener("transitionend", reset);

    if (canHover) {
      const card = wrapper.closest("article") ?? wrapper;
      card.addEventListener("pointerenter", start);
      card.addEventListener("pointerleave", stop);
    } else {
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0.5 },
      ).observe(wrapper);
    }
  }
}
</script>
